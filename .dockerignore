# Dependencies (reinstalled from the lockfile inside the builder stage)
node_modules
.pnpm-store
*-debug.log*

# Build output
.next
out

# Local environment files — never bake secrets into the image
.env
.env.*
!.env.example

# Version control and tooling
.git
.gitignore
.dockerignore
Dockerfile
charts

# Editor / OS cruft
.vscode
.idea
.DS_Store

# Tests and evaluation harness (not needed at runtime)
eval
coverage
